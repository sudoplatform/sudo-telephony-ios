# Build artifacts
.build/
.Build/
.BuildUnit/
build/
DerivedData/
*.xcresult

# SwiftPM. The package workspace is committed so CI can build the package as consumers do,
# with `-workspace .swiftpm/xcode/package.xcworkspace -scheme SudoTelephony-Package`.
.swiftpm/*
!.swiftpm/xcode/
.swiftpm/xcode/*
!.swiftpm/xcode/package.xcworkspace/
.swiftpm/xcode/package.xcworkspace/*
!.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# Xcode per-user state. Shared schemes and settings live in xcshareddata/ and are committed.
xcuserdata/

# Docs
docs/

# macOS
.DS_Store

# Integration test credentials (never commit)
config/sudoplatformconfig.json
config/register_key.private
config/register_key.id
config/api.key

# Jazzy
.jazzy.yaml.lock

config/
# GraphQL codegen tooling (see graphql/README.md)
graphql/node_modules
graphql/yarn.lock
